{
  "manifest_version": 3,
  "name": "Nice GitHub",
  "version": "0.8.0",
  "description": "Makes GitHub pull request diffs easier to review.",
  "host_permissions": [
    "https://github.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "turbo-navigation.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "permissions": [
    "storage",
    "clipboardWrite"
  ]
}
