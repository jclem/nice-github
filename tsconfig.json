{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["chrome", "node"]
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "vite.content.config.ts",
    "vite.turbo.config.ts",
    "vitest.config.ts"
  ]
}
